  "cards": [
    {
      "dot": "emerald",
      "title": "One scientific standard",
      "items": [
        "Counts validation and recovery where supported",
        "Gene mapping, QC and normalization share a final gene set",
        "Minimum: 100 cells and 5,000 detected genes per dataset, not per cell"
      ]
    },
    {
      "dot": "violet",
      "title": "A decision with evidence",
      "items": [
        "Batch: recommend correction, unnecessary, or null",
        "Cell type: existing author annotation, or null",
        "Model unavailable: built-in policy continues; all submissions are checked"
      ]
    },
    {
      "dot": "amber",
      "title": "Keep outcomes distinct",
      "items": [
        "Successful output may carry non-blocking review notes",
        "exit 1: technical failure; never disguised as a successful null",
        "Source unchanged; formal files written atomically, old outputs archived"
